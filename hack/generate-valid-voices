#!/bin/bash

set -e

# Iterate through each line of the preprocessed document content to extract the
# valid voices for the TTS models and organize them in a structured format.
declare -A valid_languages
declare -A valid_voices

infer_language() {
    local voice_id="$1"
    voice_id="$(echo -n "$voice_id" | sed -E 's/(ICL_uranus_|multi_)//g')"

    # Skip voice IDs that do not match the expected format of two letters followed by an underscore.
    echo "$voice_id" | grep -E -q "^[a-zA-Z]{2}_" || {
        return 1
    }

    # Parse the language from the voice ID
    local language="${voice_id%%_*}"

    [[ "${language,,}" == "mx" ]] && {
        echo "es-MX"
        return 0
    }

    echo "${voice_id%%_*}"
}

append_voice() {
    local resource_ids="$1"
    local language="$2"
    local voice_id="$3"
    local voice_name="$4"

    [[ " ${valid_languages["$resource_ids"]} " == *" ${language} "* ]] ||
        valid_languages["$resource_ids"]+="${language} "
    valid_voices["$resource_ids:${language}"]+="            Voice(voice_id=\"$voice_id\", name=\"$voice_name\"),\n"
}

resource_ids=""
is_supported_section="false"
while IFS= read -r line; do
    # Recognize the section of the document that lists the supported voices for the TTS models.
    case "$line" in
        *"豆包语音合成模型2.0"*"音色列表"*)
            resource_ids="seed-tts-2.0"
            is_supported_section="true"
            continue
            ;;
        *"豆包语音合成模型1.0"*"音色列表"*)
            resource_ids="seed-tts-1.0 seed-tts-1.0-concurr"
            is_supported_section="true"
            continue
            ;;
        *"音色列表"*)
            is_supported_section="false"
            continue
            ;;
    esac

    # Skip secitions that do not list the supported voices for the TTS models.
    if [[ "$is_supported_section" == "false" ]]; then
        continue
    fi

    # Skip lines that do not contain the voice information in the expected format.
    echo "$line" | grep -E -q '^| *|.+|.+|.+|' || continue
    voice_id=$(echo "$line" | awk -F '|' '{print $4}' | xargs)
    voice_name=$(echo "$line" | awk -F '|' '{print $3}' | xargs)
    [[ -z "$voice_id" || -z "$voice_name" ]] && continue

    # Infer the language from the voice ID and skip if it cannot be inferred.
    language=$(infer_language "$voice_id") || {
        echo "Warning: can not infer language for $voice_id" >&2
        continue
    }

    append_voice "$resource_ids" "$language" "$voice_id" "$voice_name"
done <<< "$(curl 'https://docs.volcengine.com/docs/zh/doubao-voice/tone-list-3.md')"

echo 'VALID_VOICES: Mapping[str, Mapping[str, list[Voice]]] = {'
for key in "${!valid_languages[@]}"; do
    for resource in $key; do
        # Print the valid voices for each TTS model in a structured format.
        echo "    \"$resource\": {"

        # Print the valid voices for each language in a structured format.
        for language in ${valid_languages["$key"]}; do
            echo "        \"$language\": ["
            echo -e "${valid_voices["$key:$language"]}" | sed '/^$/d' | sort | uniq
            echo "        ],"
        done

        # Print the closing bracket for the current TTS model.
        echo "    },"
    done
done
echo "}"
